<h1 class="text-center mb-4">Lista de Productos</h1>

{{#if products.length}}

<table class="table table-striped table-hover">

<thead class="table-dark">
<tr>
<th>ID</th>
<th>Producto</th>
<th>Precio</th>
</tr>
</thead>

<tbody>

{{#each products}}

<tr>
<td>{{this.id}}</td>
<td>{{this.title}}</td>
<td>${{this.price}}</td>
</tr>

{{/each}}

</tbody>

</table>

{{else}}

<div class="alert alert-warning text-center">
No hay productos cargados
</div>

{{/if}}
